ENVIRONMENT=development
# SQLite works out of the box for local dev; use PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://gymflow:gymflow@localhost:5432/gymflow
DATABASE_URL=sqlite:///./gymflow.db
SECRET_KEY=replace-with-a-long-random-string-of-32-plus-chars
CORS_ORIGINS=["http://localhost:3000"]

# AI. Keys may also live in the repo-root .env (this file overrides it).
# Text, drafts, diet plans and the agents' tool loop: auto = Groq if GROQ_API_KEY is set, else Claude.
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Gemini: Google/social posts, post pictures and live Google Search checks.
# Picture generation needs billing enabled on the Gemini API key (the free tier has no image quota).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Without any AI key: rule-based agents and template drafts.

# WhatsApp Cloud API (messages are logged instead of sent when unset)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# AI voice-calling provider
VOICE_API_URL=
VOICE_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# n8n
N8N_WEBHOOK_BASE_URL=
# e.g. http://localhost:5678/webhook  (leave empty to disable n8n events)
N8N_API_KEY=

# Amazon Associates
AMAZON_ASSOCIATE_TAG=

# Affiliate revenue share (% of each commission)
PLATFORM_SHARE_PCT=20
GYM_SHARE_PCT=30
TRAINER_SHARE_PCT=50

# Run expiry / payment / notification jobs inside the API process (one instance only)
ENABLE_SCHEDULER=true

# ---------------------------------------------------------------- Growth engine (Phase 1)
# Public URLs used in OAuth redirects, sitemaps and links
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000/api/v1
# Encrypts OAuth tokens at rest (defaults to a key derived from SECRET_KEY)
TOKEN_ENCRYPTION_KEY=

# Google OAuth web client (Search Console + Business Profile). Redirect URI to register in Google Cloud:
#   {PUBLIC_API_URL}/integrations/google/callback
# Business Profile APIs also need Google's API access approval for your project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# WhatsApp inbound webhooks (Meta app): POST/GET {PUBLIC_API_URL}/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SEO crawler limits
SEO_MAX_PAGES=25
SEO_REQUEST_TIMEOUT=10

PUBLIC_RATE_LIMIT_PER_MINUTE=20

# One-click "See a live demo gym" on the landing page (logs into the IronCore demo tenant only)
DEMO_LOGIN_ENABLED=true
