# Browser-side API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side (SSR of public gym sites); defaults to NEXT_PUBLIC_API_URL
API_URL_INTERNAL=http://localhost:8000/api/v1

# Branding and sales
NEXT_PUBLIC_APP_NAME=GymFlow
# Shows "See a live demo gym" on the landing and login pages (backend needs DEMO_LOGIN_ENABLED=true)
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
# Your support WhatsApp number with country code, digits only (e.g. 919824012345). Empty hides the button.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Product analytics (optional): page views + demo/sign-up/checkout events, anonymous id only
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
